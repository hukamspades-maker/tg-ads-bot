# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Dashboard environment variables — copy to `.env` and edit.
#
#  To deploy on a new VPS / panel: usually you only need to change
#  WEB_PORT (and WEB_PASSWORD + WEB_SECRET_KEY in production).
#  WEB_HOST=0.0.0.0 makes it reachable from anywhere on the network.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Server ───────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=30036

# ── Auth ─────────────────────────────────────────────────────────
WEB_USERNAME=admin
WEB_PASSWORD=admin                                # ← CHANGE THIS!
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=
WEB_JWT_SECRET=                                   # optional, defaults to WEB_SECRET_KEY
WEB_JWT_ALGORITHM=HS256
WEB_JWT_EXPIRE_MINUTES=1440                       # 24 hours

# ── CORS  (only needed if frontend is on a DIFFERENT origin) ─────
# Same-origin deployments (the default) need NO CORS at all.
# Set this only if you reverse-proxy the API on a separate domain.
# WEB_CORS_ORIGINS=https://panel.example.com,https://admin.example.com

# ── Cookies (set to 1 only behind HTTPS) ─────────────────────────
WEB_COOKIE_SECURE=0

# ── Database  (default: local SQLite, no setup) ──────────────────
# WEB_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
WEB_DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ── Performance ──────────────────────────────────────────────────
WEB_MAX_CONCURRENT_SENDS=10
WEB_QUEUE_MAX_SIZE=10000
WEB_WORKER_COUNT=4
WEB_BATCH_SIZE=50
